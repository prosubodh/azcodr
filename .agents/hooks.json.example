{
  "safety-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/safety_guard.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "architectural-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/agent_guard.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "post-tool-lint": {
    "enabled": false,
    "PostToolUse": [
      {
        "type": "command",
        "command": "npm run lint",
        "timeout": 30
      }
    ]
  },
  "stop-verifier": {
    "enabled": false,
    "Stop": [
      {
        "type": "command",
        "command": "node .agents/scripts/verify_completion.js",
        "timeout": 120
      }
    ]
  }
}