{
  "safety-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./.agents/scripts/safety_guard.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "post-tool-lint": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "stop-verifier": {
    "enabled": false,
    "Stop": [
      {
        "type": "command",
        "command": "./.agents/scripts/verify_completion.sh",
        "timeout": 15
      }
    ]
  }
}
