{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "rules": {
    "no-unused-vars": ["error", { "args": "after-used", "caughtErrors": "none" }]
  },
  "ignorePatterns": [
    "coverage/**",
    "scratch/**",
    ".agents/**",
    "**/*.d.ts",
    "examples/**",
    "lib/**",
    "tests/**"
  ]
}