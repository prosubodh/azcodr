{
  "name": "azcodr",
  "version": "1.4.0",
  "description": "Enterprise Architecture & Agentic Engineering Starter Template",
  "bin": {
    "azcodr": "bin/azcodr.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "AGENTS.md",
    "memory.md",
    "README.md",
    "docs",
    ".agents",
    ".gitignore",
    ".editorconfig",
    "LICENSE"
  ],
  "keywords": [
    "starter-template",
    "agentic",
    "multi-tenant",
    "enterprise-architecture",
    "scaffolding",
    "ai-coding",
    "agents",
    "npx"
  ],
  "author": "Subodh Khanal <prosubodh+git@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosubodh/azcodr.git"
  },
  "bugs": {
    "url": "https://github.com/prosubodh/azcodr/issues"
  },
  "homepage": "https://github.com/prosubodh/azcodr#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node scripts/test_coverage.js",
    "lint": "node --check bin/azcodr.js lib/index.js lib/scaffold.js tests/cli.test.js tests/scaffold.test.js scripts/test_coverage.js",
    "validate": "bash .agents/skills/agentic-architect/scripts/validate_agentic_configs.sh",
    "prepublishOnly": "npm run lint && npm run test:coverage && npm run validate"
  }
}
