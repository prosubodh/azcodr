{
  "name": "azcodr",
  "version": "2.11.0",
  "description": "Architecture governance toolkit: zero-dependency boundary & cycle detection, fail-closed validation, and declarative configuration via harness.yaml",
  "type": "module",
  "bin": {
    "azcodr": "bin/azcodr.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "data",
    "scripts",
    ".agents",
    "AGENTS.md",
    "memory.md",
    "README.md",
    ".gitignore",
    ".editorconfig",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "keywords": [
    "architecture-governance",
    "boundary-detection",
    "cycle-detection",
    "validate",
    "ai-coding",
    "agents",
    "npx"
  ],
  "author": "Subodh Khanal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosubodh/azcodr.git"
  },
  "bugs": {
    "url": "https://github.com/prosubodh/azcodr/issues"
  },
  "homepage": "https://github.com/prosubodh/azcodr#readme",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "validate": "node bin/azcodr.js check",
    "prepublishOnly": "npm run build && npm run lint && npm run test:coverage && npm run validate"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@vitest/coverage-istanbul": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "5.7.3",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "braces": "3.0.3",
    "sprintf-js": "1.1.3"
  }
}
