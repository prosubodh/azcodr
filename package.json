{
  "name": "azcodr",
  "version": "2.1.0",
  "description": "Enterprise Architecture & Agentic Engineering Starter Template",
  "type": "module",
  "bin": {
    "azcodr": "bin/azcodr.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "scripts",
    "data",
    ".github",
    "AGENTS.md",
    "memory.md",
    "README.md",
    "docs",
    ".agents",
    ".gitignore",
    ".editorconfig",
    "LICENSE"
  ],
  "keywords": [
    "starter-template",
    "agentic",
    "multi-tenant",
    "enterprise-architecture",
    "scaffolding",
    "ai-coding",
    "agents",
    "npx"
  ],
  "author": "Subodh Khanal <prosubodh+git@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosubodh/azcodr.git"
  },
  "bugs": {
    "url": "https://github.com/prosubodh/azcodr/issues"
  },
  "homepage": "https://github.com/prosubodh/azcodr#readme",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test",
    "test:coverage": "node scripts/test_coverage.js",
    "test:jest": "jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-cli.js",
    "prepublishOnly": "npm run build && npm run lint && npm run test:coverage && npm run validate"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.6",
    "typescript": "5.7.3"
  }
}
