{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "packageManager": "npm",
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/errors.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  }
}
